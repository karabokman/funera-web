# Copy to .env and fill in. Never commit .env.
SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=funera.example.com
SITE_URL=https://funera.example.com
ADMIN_URL=manage-xyz123/      # keep the trailing slash; do not leave it as admin/
POSTGRES_PASSWORD=
DJANGO_SETTINGS_MODULE=config.settings.production

# Shown on the site and in the privacy notice
COMPANY_LEGAL_NAME=Funera (Pty) Ltd
CONTACT_EMAIL=hello@funera.example.com
CONTACT_PHONE=
INFORMATION_OFFICER_EMAIL=privacy@funera.example.com
SALES_NOTIFY_EMAILS=sales@funera.example.com

# E-mail (enquiry notifications and acknowledgements)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Funera <no-reply@funera.example.com>

# PayFast subscriptions. Leave the merchant values empty to keep online sign-up switched off (plans show "Talk to us").
# Production refuses to start while PAYFAST_SANDBOX is True and merchant details are set, or if the passphrase is empty.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=           # set the same value in the PayFast dashboard (Settings > Integration)
PAYFAST_SANDBOX=True          # set False for real payments
BILLING_TRUSTED_PROXIES=1     # reverse proxies in front of the app (Caddy/nginx = 1)

# Optional
LEAD_RETENTION_MONTHS=24
LEAD_RATE_LIMIT_PER_HOUR=5
PLAUSIBLE_DOMAIN=
LOG_LEVEL=INFO
