# Copy to .env and fill in. Never commit .env.
# IMPORTANT: put comments on their own line, never after a value (the value would include the comment).

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=funera.co.za
SITE_URL=https://funera.co.za
# Keep the trailing slash; do not leave it as admin/
ADMIN_URL=manage-xyz123/
POSTGRES_PASSWORD=
DJANGO_SETTINGS_MODULE=config.settings.production

# Shown on the site and in the privacy notice
COMPANY_LEGAL_NAME=Agencode Technologies (Pty) Ltd
CONTACT_EMAIL=info@funera.co.za
CONTACT_PHONE=
INFORMATION_OFFICER_EMAIL=privacy@funera.co.za
SALES_NOTIFY_EMAILS=sales@funera.co.za

# E-mail (enquiries, receipts, portal sign-in links)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Funera <no-reply@funera.co.za>

# PayFast subscriptions. Leave the merchant values empty to keep online sign-up switched off.
# Production refuses to start while PAYFAST_SANDBOX is True and merchant details are set, or if the passphrase is empty.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Set the same value in the PayFast dashboard (Settings > Integration)
PAYFAST_PASSPHRASE=
# Set to False for real payments
PAYFAST_SANDBOX=True
# Number of reverse proxies in front of the app (Caddy or nginx = 1)
BILLING_TRUSTED_PROXIES=1

# Client portal, pausing and refunds
# Minutes an e-mailed sign-in link works
PORTAL_LOGIN_MINUTES=20
PORTAL_SESSION_HOURS=2
# Sign-in link requests allowed per visitor per hour
PORTAL_LOGIN_RATE_PER_HOUR=5
# Most billing periods a client may pause for
PAUSE_MAX_CYCLES=3
# Days after a payment in which a client may request a refund
REFUND_WINDOW_DAYS=7

# Optional
LEAD_RETENTION_MONTHS=24
LEAD_RATE_LIMIT_PER_HOUR=5
PLAUSIBLE_DOMAIN=
LOG_LEVEL=INFO
