# Copy to .env and fill in. Never commit .env.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=funera.co.za
SITE_URL=https://funera.co.za
# keep the trailing slash; do not leave it as admin/
ADMIN_URL=manage-xyz123/
POSTGRES_PASSWORD=
DJANGO_SETTINGS_MODULE=config.settings.production

# Shown on the site and in the privacy notice
COMPANY_LEGAL_NAME=Agencode Technologies (Pty) Ltd
CONTACT_EMAIL=info@funera.co.za
CONTACT_PHONE=
INFORMATION_OFFICER_EMAIL=privacy@funera.co.za
SALES_NOTIFY_EMAILS=sales@funera.co.za

# E-mail (enquiry notifications and acknowledgements)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Funera <no-reply@funera.co.za>

# PayFast subscriptions. Leave the merchant values empty to keep online sign-up switched off (plans show "Talk to us").
# Production refuses to start while PAYFAST_SANDBOX is True and merchant details are set, or if the passphrase is empty.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# set the same value in the PayFast dashboard (Settings > Integration)
PAYFAST_PASSPHRASE=
# set False for real payments         
PAYFAST_SANDBOX=True
# reverse proxies in front of the app (Caddy/nginx = 1)
BILLING_TRUSTED_PROXIES=1

# Optional
LEAD_RETENTION_MONTHS=24
LEAD_RATE_LIMIT_PER_HOUR=5
PLAUSIBLE_DOMAIN=
LOG_LEVEL=INFO
